PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=valenor_watches

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_before_production
SESSION_SECRET=replace_with_a_long_random_session_secret

# Security & Rate Limiting
CORS_ORIGIN=http://localhost:5000
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_API_MAX=400

